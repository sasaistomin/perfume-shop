# Змінні для Vercel (Settings → Environment Variables)
ADMIN_PASSWORD=довгий-пароль-від-12-символів
SESSION_SECRET=результат-команди-openssl-rand-hex-32
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
NOVA_POSHTA_API_KEY=

# Пошук (Google / Bing)
# Основна адреса сайту — її бачать пошуковики (canonical, sitemap). Інші адреси отримують noindex.
SITE_URL=https://delasparfume.vercel.app
# Код із Google Search Console (спосіб «HTML-тег», лише значення content="…")
GOOGLE_SITE_VERIFICATION=
# Код із Bing Webmaster Tools (тег msvalidate.01, лише значення content="…")
BING_SITE_VERIFICATION=
